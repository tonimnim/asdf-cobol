#!/usr/bin/env bash
# Build & install phase. When invoked by asdf >= 0.7 the source has already
# been fetched into $ASDF_DOWNLOAD_PATH by bin/download. For older asdf we
# fetch inline into a temp dir.
set -euo pipefail

plugin_dir=$(cd "$(dirname "$(dirname "$0")")" && pwd)
# shellcheck source=../lib/utils.bash
source "$plugin_dir/lib/utils.bash"

[ -n "${ASDF_INSTALL_TYPE:-}" ]    || fail "ASDF_INSTALL_TYPE not set"
[ -n "${ASDF_INSTALL_VERSION:-}" ] || fail "ASDF_INSTALL_VERSION not set"
[ -n "${ASDF_INSTALL_PATH:-}" ]    || fail "ASDF_INSTALL_PATH not set"

if [ "$ASDF_INSTALL_TYPE" != "version" ]; then
  fail "installing by ref is not supported"
fi

require_build_tools
warn_missing_libs

cleanup=""
if [ -n "${ASDF_DOWNLOAD_PATH:-}" ] && [ -d "$ASDF_DOWNLOAD_PATH" ]; then
  src="$ASDF_DOWNLOAD_PATH"
else
  src=$(mktemp -d -t asdf-cobol-XXXXXX)
  cleanup="$src"
  trap '[ -n "$cleanup" ] && rm -rf "$cleanup"' EXIT
  tarball="$src/$(tarball_name "$ASDF_INSTALL_VERSION")"
  download_release "$ASDF_INSTALL_VERSION" "$tarball"
  tar -xzf "$tarball" -C "$src" --strip-components=1
  rm -f "$tarball"
fi

jobs=$(detect_jobs)

(
  cd "$src"
  ./configure --without-db --prefix="$ASDF_INSTALL_PATH"
  make -j"$jobs"
  make install
)

# Smoke test: ensure cobc actually runs after install. Library lookups need
# the freshly installed lib dir on LD_LIBRARY_PATH.
if ! LD_LIBRARY_PATH="$ASDF_INSTALL_PATH/lib:${LD_LIBRARY_PATH:-}" \
     "$ASDF_INSTALL_PATH/bin/cobc" --version >/dev/null 2>&1; then
  fail "post-install check failed: cobc did not run from $ASDF_INSTALL_PATH/bin"
fi

echo "asdf-cobol: installed GnuCOBOL $ASDF_INSTALL_VERSION to $ASDF_INSTALL_PATH"
